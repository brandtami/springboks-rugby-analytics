# ============================================================
# 06_tier_analysis.ipynb
# Tier-1 vs. Rest Analyse + WM 2027 Outlook
# ============================================================

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import matplotlib.patches as mpatches
import seaborn as sns
from sklearn.metrics import accuracy_score, roc_auc_score
import joblib
import warnings
warnings.filterwarnings('ignore')

# Springboks Farben
DARK_GREEN = '#1B5E20'
GOLD       = '#C9A84C'
LIGHT_GREEN = '#4CAF50'

# ── 1. Daten laden ───────────────────────────────────────────
df = pd.read_parquet('data/gold/springboks_gold.parquet')

# Tier-1 Gegner (World Rugby Tier 1 Nations)
TIER1 = {
    'New Zealand', 'Australia', 'England', 'France',
    'Ireland', 'Wales', 'Scotland', 'Argentina', 'Italy'
}

df['tier'] = df['opponent'].apply(
    lambda x: 'Tier 1' if x in TIER1 else 'Tier 2+'
)

# ── 2. Deskriptive Statistik nach Tier ──────────────────────
print("=== Win Rate nach Tier (gesamter Datensatz) ===")
tier_stats = df.groupby('tier').agg(
    matches    = ('win', 'count'),
    wins       = ('win', 'sum'),
    win_rate   = ('win', 'mean'),
    avg_margin = ('score_margin', 'mean')
).round(3)
print(tier_stats)
tier_stats.to_csv('reports/tier_stats.csv')

# ── 3. Modell laden und Vorhersagen machen ───────────────────
# Test-Set: 2017 onwards (wie in Notebook 04/05)
test_mask = df['date'].dt.year >= 2017
df_test   = df[test_mask].copy()
df_train  = df[~test_mask].copy()

print(f"\nTest-Set: {len(df_test)} Spiele "
      f"({df_test['tier'].value_counts().to_dict()})")

# Features (gleiche wie in Notebook 04)
FEATURES = [
    'rolling_form_3', 'rolling_form_5', 'rolling_margin_3',
    'h2h_winrate', 'elo_diff_pre', 'days_since_prev', 'home'
]

# Modell neu trainieren (damit keine Abhängigkeit von gespeicherten Files)
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LogisticRegression

pipe = Pipeline([
    ('scaler', StandardScaler()),
    ('clf', LogisticRegression(C=1.0, max_iter=1000, random_state=42))
])

X_train = df_train[FEATURES].fillna(df_train[FEATURES].median())
y_train = df_train['win']
X_test  = df_test[FEATURES].fillna(df_train[FEATURES].median())
y_test  = df_test['win']

pipe.fit(X_train, y_train)
df_test['pred']      = pipe.predict(X_test)
df_test['pred_prob'] = pipe.predict_proba(X_test)[:, 1]

# ── 4. Performance nach Tier ─────────────────────────────────
print("\n=== Modellperformance nach Tier (Test-Set 2017+) ===")
results = []
for tier in ['Tier 1', 'Tier 2+', 'All']:
    if tier == 'All':
        subset = df_test
    else:
        subset = df_test[df_test['tier'] == tier]
    
    if len(subset) == 0:
        continue
    
    acc  = accuracy_score(subset['win'], subset['pred'])
    n    = len(subset)
    wins = subset['win'].sum()
    
    # 95% CI für Accuracy (Normalapproximation)
    se = np.sqrt(acc * (1 - acc) / n)
    ci_low  = max(0, acc - 1.96 * se)
    ci_high = min(1, acc + 1.96 * se)
    
    # Baseline: Majority class
    baseline = subset['win'].mean()
    
    try:
        auc = roc_auc_score(subset['win'], subset['pred_prob'])
    except:
        auc = np.nan
    
    results.append({
        'Tier':        tier,
        'N matches':   n,
        'Actual wins': wins,
        'Win rate':    round(baseline, 3),
        'Accuracy':    round(acc, 3),
        '95% CI':      f'[{ci_low:.2f}, {ci_high:.2f}]',
        'ROC-AUC':     round(auc, 3) if not np.isnan(auc) else '--'
    })

results_df = pd.DataFrame(results)
print(results_df.to_string(index=False))
results_df.to_csv('reports/tier_performance.csv', index=False)

# ── 5. Visualisierung: Win Rate und Accuracy nach Tier ───────
fig, axes = plt.subplots(1, 2, figsize=(12, 5))
fig.suptitle('Springboks – Tier-1 vs. Tier-2 Analysis', 
             fontsize=14, fontweight='bold', color=DARK_GREEN)

# Plot 1: Win Rate im gesamten Datensatz
tier_plot = tier_stats.reset_index()
colors = [DARK_GREEN if t == 'Tier 1' else GOLD 
          for t in tier_plot['tier']]
axes[0].bar(tier_plot['tier'], tier_plot['win_rate'], 
            color=colors, edgecolor='white', width=0.5)
axes[0].axhline(0.5, color='grey', linestyle='--', 
                linewidth=1, label='50% baseline')
axes[0].set_title('Win Rate by Opponent Tier (1992–2022)',
                  fontsize=11)
axes[0].set_ylabel('Win Rate')
axes[0].set_ylim(0, 1)
axes[0].legend()
for i, (_, row) in enumerate(tier_plot.iterrows()):
    axes[0].text(i, row['win_rate'] + 0.02, 
                 f"{row['win_rate']:.1%}\nn={int(row['matches'])}",
                 ha='center', fontsize=10)

# Plot 2: Modell-Accuracy nach Tier (Test-Set)
tier_acc = results_df[results_df['Tier'] != 'All']
colors2  = [DARK_GREEN if t == 'Tier 1' else GOLD 
            for t in tier_acc['Tier']]
axes[1].bar(tier_acc['Tier'], tier_acc['Accuracy'],
            color=colors2, edgecolor='white', width=0.5)
# Baseline als Linie
for i, (_, row) in enumerate(tier_acc.iterrows()):
    axes[1].axhline(row['Win rate'], color=colors2[i],
                    linestyle=':', linewidth=1.5, alpha=0.6)
axes[1].set_title('Model Accuracy by Tier\n(Test Set 2017–2022)',
                  fontsize=11)
axes[1].set_ylabel('Accuracy')
axes[1].set_ylim(0, 1)
for i, (_, row) in enumerate(tier_acc.iterrows()):
    axes[1].text(i, row['Accuracy'] + 0.02,
                 f"{row['Accuracy']:.1%}\n{row['95% CI']}",
                 ha='center', fontsize=9)

plt.tight_layout()
plt.savefig('figures/tier_analysis.pdf', bbox_inches='tight')
plt.savefig('figures/tier_analysis.png', bbox_inches='tight', dpi=150)
plt.show()
print("Gespeichert: figures/tier_analysis.pdf")

# ── 6. WM 2027 Outlook ───────────────────────────────────────
print("\n=== WM 2027 Outlook: Potenzielle Gegner ===")

# Häufige WM-Gegner aus dem Datensatz
wm_opponents = [
    'New Zealand', 'Australia', 'England', 
    'France', 'Ireland', 'Argentina', 'Wales', 'Scotland'
]

wm_stats = []
for opp in wm_opponents:
    subset = df[df['opponent'] == opp]
    if len(subset) == 0:
        continue
    
    # Nur letzten 5 Jahre für aktuellen Form-Kontext
    recent = df[(df['opponent'] == opp) & 
                (df['date'].dt.year >= 2018)]
    
    wm_stats.append({
        'Opponent':           opp,
        'Total matches':      len(subset),
        'Overall win rate':   round(subset['win'].mean(), 3),
        'Recent win rate\n(2018–2022)': 
            round(recent['win'].mean(), 3) if len(recent) > 0 else '--',
        'Avg Elo diff':       round(subset['elo_diff_pre'].mean(), 1),
        'Tier':               'Tier 1'
    })

wm_df = pd.DataFrame(wm_stats).sort_values('Overall win rate', 
                                             ascending=False)
print(wm_df.to_string(index=False))
wm_df.to_csv('reports/wm2027_opponents.csv', index=False)

# ── 7. WM Visualisierung ─────────────────────────────────────
fig, ax = plt.subplots(figsize=(10, 5))

colors_wm = [DARK_GREEN if w >= 0.5 else GOLD 
             for w in wm_df['Overall win rate']]
bars = ax.barh(wm_df['Opponent'], wm_df['Overall win rate'],
               color=colors_wm, edgecolor='white')
ax.axvline(0.5, color='grey', linestyle='--', 
           linewidth=1.5, label='50%')
ax.set_xlabel('Win Rate (1992–2022)')
ax.set_title('Springboks Win Rate vs. Likely 2027 RWC Opponents',
             fontsize=12, fontweight='bold', color=DARK_GREEN)

for bar, val in zip(bars, wm_df['Overall win rate']):
    ax.text(val + 0.01, bar.get_y() + bar.get_height()/2,
            f'{val:.1%}', va='center', fontsize=10)

green_patch = mpatches.Patch(color=DARK_GREEN, label='Win rate ≥ 50%')
gold_patch  = mpatches.Patch(color=GOLD,       label='Win rate < 50%')
ax.legend(handles=[green_patch, gold_patch])
ax.set_xlim(0, 1)

plt.tight_layout()
plt.savefig('figures/wm2027_outlook.pdf', bbox_inches='tight')
plt.savefig('figures/wm2027_outlook.png', bbox_inches='tight', dpi=150)
plt.show()
print("Gespeichert: figures/wm2027_outlook.pdf")

print("\n✅ Tier-Analyse abgeschlossen.")
